NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/learnsphere?retryWrites=true&w=majority
# At least 32 random characters
SESSION_SECRET=
# Origin of the Next.js web app (CORS allowlist)
APP_ORIGIN=http://localhost:3000
# Used only by: npm run seed:admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Needed if your network DNS cannot resolve mongodb+srv (querySrv ECONNREFUSED)
DNS_SERVERS=8.8.8.8,1.1.1.1
