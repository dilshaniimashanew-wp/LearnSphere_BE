NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/learnsphere?retryWrites=true&w=majority
# At least 32 random characters
SESSION_SECRET=
# Origin of the Next.js web app (CORS allowlist)
APP_ORIGIN=http://localhost:3000
# Used only by: npm run seed:admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Needed if your network DNS cannot resolve mongodb+srv (querySrv ECONNREFUSED)
DNS_SERVERS=8.8.8.8,1.1.1.1

# Optional tuning (defaults shown). Keep AUTH_RATE_LIMIT low in production.
# AUTH_RATE_LIMIT=30        # login/register requests per IP per 15 minutes
# API_RATE_LIMIT=600        # all API requests per IP per 15 minutes
# TRUST_PROXY=0             # number of reverse proxies in front of the API
# ENABLE_DOCS=true          # Swagger UI at /api/v1/docs (off by default in production)
